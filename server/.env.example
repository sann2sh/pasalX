# Server
PORT=8080
BIND_ADDR=127.0.0.1
PASALX_ENV=development
TRUST_PROXY=0

# PostgreSQL
DATABASE_URL=postgres://pasalx:pasalx_dev_pass@localhost:5432/pasalx_db?sslmode=disable
DATABASE_MIGRATE_URL=postgres://pasalx:pasalx_dev_pass@localhost:5432/pasalx_db?sslmode=disable

# Master key (min 32 bytes hex/base64, generate with: go run ./cmd/pasalx-admin gen-master-key)
PASALX_MASTER_KEY=replace-with-generated-32-byte-master-key

# SMTP (optional in dev; leave blank to use LogMailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
